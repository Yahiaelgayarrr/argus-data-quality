# ---------------------------------------------------------------------------
# Data — never committed. See docs/adr/0009-data-versioning-tool.md
# ---------------------------------------------------------------------------
data/*
!data/.gitkeep
!data/fixtures/

# Dataset payloads are ignored wherever they land, not only under data/.
# A 1.6 GB download parked in the repository root must not be committable by
# accident: a large blob stays in Git history permanently even after deletion.
*.csv
*.csv.gz
*.tsv
*.parquet
*.feather
*.arrow
*.xlsx

# The one exception: small committed fixtures, so the test suite runs on a
# fresh clone with no download. These negations must come last to win.
!tests/fixtures/
!tests/fixtures/**
!data/fixtures/**

# Ground-truth corruption labels are generated, not committed
labels/
*.labels.json

# Ground-truth corruption labels are generated, not committed
labels/
*.labels.json

# ---------------------------------------------------------------------------
# Generated outputs
# ---------------------------------------------------------------------------
outputs/*
!outputs/.gitkeep
reports/*
!reports/.gitkeep
*.log

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# Environments
.venv/
venv/
env/
.python-version

# ---------------------------------------------------------------------------
# DVC
# ---------------------------------------------------------------------------
/.dvc/cache
/.dvc/tmp
/.dvc/config.local

# ---------------------------------------------------------------------------
# ML artifacts
# ---------------------------------------------------------------------------
models/*
!models/.gitkeep
*.pt
*.pth
*.onnx
*.joblib
*.pkl
.cache/
sentence_transformers_cache/

# ---------------------------------------------------------------------------
# Notebooks
# ---------------------------------------------------------------------------
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Dashboard (Module 4)
# ---------------------------------------------------------------------------
dashboard/node_modules/
dashboard/dist/
dashboard/.vite/
npm-debug.log*

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
